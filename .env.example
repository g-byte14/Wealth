# Required for real analysis. Without it the app runs in offline demo mode.
ANTHROPIC_API_KEY=

# Optional: fetch the methodology from a URL at request time instead of the local
# ./methodology folder, e.g.
# https://raw.githubusercontent.com/<owner>/<repo>/<branch>/methodology
METHODOLOGY_URL=

# Optional: force demo mode even when an API key is set (true/false)
DEMO_MODE=
